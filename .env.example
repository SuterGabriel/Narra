# Copy to .env.local for local development. Set the same keys in Vercel for deploys.

# Better Stack Telemetry: HTTP source. Ingest URL looks like https://s123456.eu-nbg-2.betterstackdata.com
BETTERSTACK_INGEST_URL=
BETTERSTACK_SOURCE_TOKEN=

# Claude API (question feature). Added in the /api/ask step.
ANTHROPIC_API_KEY=

# ElevenLabs (audiobook, pronunciation, voice tutor). Added in week 2.
ELEVENLABS_API_KEY=

# Supabase (Postgres): request log, cost ledger, rate limits, leaderboard. Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
